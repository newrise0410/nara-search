# Supabase Direct/Session pooler 5432 또는 로컬 Postgres 접속 문자열
DATABASE_URL=
# 공공데이터포털 Decoding 인증키 (apps/web/.env 의 NARA_API_KEY 와 같은 값)
NARA_API_KEY=
NARA_BASE_URL=https://apis.data.go.kr/1230000
WORKER_BUDGET_MS=600000
# 알림 링크의 베이스 URL
APP_URL=http://localhost:3000
# 카카오 토큰을 암호화할 32바이트 hex(64자) 키
ALERT_SECRET_KEY=
# 카카오 REST API와 선택적 Client Secret
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
# Resend 발송 설정
RESEND_API_KEY=
ALERT_FROM_EMAIL=
# 웹푸시 VAPID 설정
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 선택. 운영자 오류 알림 웹훅
ADMIN_WEBHOOK_URL=
